[Unit]
Description=FileForge Gunicorn
After=network.target

[Service]
LimitNOFILE=65535
LimitNPROC=4096
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/FileForge
ExecStart=/home/ubuntu/FileForge/venv/bin/gunicorn -c gunicorn_conf.py app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
